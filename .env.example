# نظام مَشيد (repo root app: masheedwaqf.com + system.masheedwaqf.com)
# Copy to .env.local for development; set the same names in Vercel. Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Records verified payments and what they unlock, and opens meeting links for guests.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SYSTEM_URL=https://system.masheedwaqf.com

# Moyasar (use the test keys first: pk_test_… / sk_test_…)
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# Webhook secret token set in the Moyasar dashboard for https://system.masheedwaqf.com/api/payments/webhook
MOYASAR_WEBHOOK_SECRET=

# ZEGOCLOUD (project AppID and the 32-character ServerSecret)
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
