generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------
// Enums
// -----------------------------------------

enum NationalityType {
  SAUDI
  FOREIGNER
}

enum WaqfType {
  REAL_ESTATE
  CASH
  FARMS
  LANDS
}

enum YieldDestination {
  HEALTH
  EDUCATION
  MOSQUES
  ORPHANS
  GENERAL
}

// -----------------------------------------
// Models
// -----------------------------------------

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  nationality    NationalityType
  
  tokens         Token[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Waqf {
  id              String       @id @default(uuid())
  title           String
  description     String
  
  // Constraint: Foreigners can only buy CASH Awqaf.
  type            WaqfType
  
  totalTokens     Int
  availableTokens Int
  tokenPrice      Float        // Principal amount per token (Irrevocable)
  
  tokens          Token[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Token {
  id               String           @id @default(uuid())
  userId           String
  waqfId           String
  
  // How many fractional shares does the user own
  quantity         Int
  
  // Yield Redirection: Where does the profit generated by this token go?
  yieldDestination YieldDestination @default(GENERAL) 
  
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  waqf             Waqf             @relation(fields: [waqfId], references: [id], onDelete: Restrict)
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}
